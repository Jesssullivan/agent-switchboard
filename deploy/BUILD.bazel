load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

# The swb binary as an image layer. This is the CI package target today and
# the input layer of the P1b image.
pkg_tar(
    name = "swb_layer",
    srcs = ["//crates/swb:swb"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

